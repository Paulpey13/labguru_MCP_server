# Labguru MCP server configuration.
# Copy this file to ".env" and fill in your values. The .env file is loaded
# automatically. Every value below can also be set as a real environment
# variable or in labguru.config.json (see labguru.config.example.json).

# --- Instance ---------------------------------------------------------------
# Domain only, without scheme. Default: eu.labguru.com
LABGURU_DOMAIN=eu.labguru.com
# Full base URL. Overrides LABGURU_DOMAIN if set.
# LABGURU_BASE_URL=https://eu.labguru.com

# --- Authentication (pick one) ---------------------------------------------
# Personal API token (recommended). Generate it in Labguru: Account > API token.
LABGURU_TOKEN=your_token_here
# Alternative: email + password (used only when no token is set). Exchanged for
# a session token via POST /api/v1/sessions.json, with auto re-auth on expiry.
# LABGURU_LOGIN=you@example.com
# LABGURU_PASSWORD=your_password

# --- Behaviour (optional) ---------------------------------------------------
# Disable all write tools (create/update/upload/api_request). "true" / "false".
# LABGURU_READ_ONLY=false
# HTTP timeout in seconds (default 60).
# LABGURU_TIMEOUT=60
# Max concurrent API calls during fan-out scans (default 8).
# LABGURU_MAX_CONCURRENCY=8

# --- Inventory customisation (optional) -------------------------------------
# Override the collections this instance exposes (comma-separated). Add your
# lab's custom biocollections here so inventory tools can reach them.
# LABGURU_BIOCOLLECTIONS=biochemistry,culture,crispr,mrna,rodents,sirna,taqman,sp_bioch
# LABGURU_DIRECT_INVENTORY=antibodies,cell_lines,plasmids,primers

# CMR custom-field mapping per collection, as JSON. Defaults shown.
# LABGURU_CMR_MAP={"biochemistry":{"risk":"custom5","measure":"custom6"},"culture":{"risk":"custom3","measure":"custom4"},"sp_bioch":{"risk":"custom3","measure":"custom4"}}
